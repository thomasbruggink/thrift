FROM ubuntu:22.04

SHELL ["/bin/bash", "-eux", "-o", "pipefail", "-c"]

RUN apt-get update && \
    apt-get install -y \
        wget \
        mingw-w64

ARG BAZELISK_VERSION=1.26.0

RUN ARCH=`uname -m` && \
    if [ $ARCH = "x86_64" ]; then ARCH="amd64"; fi && \
    wget https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/bazelisk-linux-$ARCH && \
    mkdir -p /opt/bazel && \
    mv bazelisk-linux-$ARCH /opt/bazel/bazel && \
    chmod +x /opt/bazel/bazel

ENV PATH=$PATH:/opt/bazel

COPY .bazelversion /

RUN bazel --version

WORKDIR /thrift
