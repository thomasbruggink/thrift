    strip_include_prefix = "lib/",
)

cc_library(
    name = "bison_skel",
    hdrs = [
        "src/scan-skel.c",
        "src/scan-gram.c",
        "src/scan-code.c"
    ]
)

filegroup(
    name = "bison_share",
    srcs = glob([
        "data/**"
    ]),
    visibility = ["//visibility:public"]
)

cc_binary(
    name = "bison",
    srcs = glob([
        "src/**/*.c",
        "src/**/*.h",
    ], exclude = [
        "src/i18n-strings.c",
        "src/scan-skel.c",
        "src/scan-gram.c",
        "src/scan-code.c",
    ]),
    copts = [
        "-x",
        "c",
    ],
    linkopts = select({
        ":apple": [
            "-lintl",
            "-ltextstyle",
        ],
        "//conditions:default": [],
    }),
    defines = [
        "HAVE_CONFIG_H",
    ],
    deps = [
        ":bison_lib",
        ":bison_skel",
        "@//external/bison:bison_headers",
    ],
    visibility = ["//visibility:public"],
)
