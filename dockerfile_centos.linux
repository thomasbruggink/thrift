FROM vcr.linecorp.com/line-shop/centos7-build:latest

SHELL ["/bin/bash", "-eux", "-o", "pipefail", "-c"]

RUN yum install -y \
        bison \
        flex \
        openssl-devel && \
    yum clean all

RUN wget -O /tmp/cmake.tar.gz \
      https://line-objects-internal.com/shop-binrepo/cmake-3.31.11.tar.gz && \
    mkdir /tmp/cmake && \
    tar -xzf /tmp/cmake.tar.gz --strip-components=1 -C /tmp/cmake && \
    cd /tmp/cmake && \
    ./bootstrap --prefix=/opt/cmake --parallel="$(nproc)" && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /tmp/cmake /tmp/cmake.tar.gz

ENV PATH=/opt/cmake/bin:$PATH

RUN cmake --version

WORKDIR /thrift
