FROM vcr.linecorp.com/line-shop/centos7-build:latest

SHELL ["/bin/bash", "-eux", "-o", "pipefail", "-c"]

ARG BAZEL_VERSION=8.2.1

RUN mkdir -p /opt/bazel && \
    wget -O /opt/bazel/bazel \
      "https://releases.bazel.build/${BAZEL_VERSION}/release/bazel-${BAZEL_VERSION}-linux-x86_64" && \
    echo "7ff2b6a675b59a791d007c526977d5262ade8fa52efc8e0d1ff9e18859909fc0  /opt/bazel/bazel" \
      | sha256sum -c - && \
    chmod +x /opt/bazel/bazel

ENV PATH=$PATH:/opt/bazel

RUN bazel --version

WORKDIR /thrift
