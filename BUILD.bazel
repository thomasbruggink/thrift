constraint_setting(name = "mingw")

constraint_value(
    name = "windows-cross",
    constraint_setting = ":mingw",
    visibility = ["//visibility:public"]
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64"
    ],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64"
    ],
)

platform(
    name = "windows_x86-64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":windows-cross"
    ],
)
